DATABASE_URL=postgresql://agentos:agentos@postgres:5432/agentos
REDIS_URL=redis://redis:6379/0
OLLAMA_URL=http://ollama:11434
CHAT_MODEL=qwen2.5:14b-instruct
CODE_MODEL=qwen2.5-coder:14b
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# ABSOLUTE path on the docker HOST (sandbox containers mount it). e.g. /home/me/agentos/runs
HOST_RUNS_DIR=/absolute/path/to/agentos/runs
SANDBOX_MODE=docker
REQUIRE_PLAN_APPROVAL=true
MAX_RETRIES=2
# optional: SEARXNG_URL=http://searxng:8080
